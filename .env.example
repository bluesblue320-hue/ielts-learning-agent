# Copy this file to .env and supply local-only values as services require.
# Never commit real credentials.
IELTS_ENVIRONMENT=development
IELTS_DEEPSEEK_API_KEY=
IELTS_DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
IELTS_DEEPSEEK_MODEL=deepseek-v4-pro
IELTS_DEEPSEEK_TIMEOUT_SECONDS=30
IELTS_DEEPSEEK_THINKING_MODE=disabled
IELTS_DATABASE_URL=postgresql+psycopg://ielts_app:replace-with-local-password@localhost:5432/ielts_agent
IELTS_DOCKER_DATABASE_URL=postgresql+psycopg://ielts_app:replace-with-local-password@db:5432/ielts_agent
IELTS_TEST_DATABASE_URL=postgresql+psycopg://ielts_test:replace-with-local-test-password@localhost:5433/ielts_agent_test
IELTS_DOCKER_TEST_DATABASE_URL=postgresql+psycopg://ielts_test:replace-with-local-test-password@test-db:5432/ielts_agent_test
POSTGRES_USER=ielts_app
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=ielts_agent
POSTGRES_PORT=5432
TEST_POSTGRES_USER=ielts_test
TEST_POSTGRES_PASSWORD=replace-with-local-test-password
TEST_POSTGRES_DB=ielts_agent_test
TEST_POSTGRES_PORT=5433
API_PORT=8000
