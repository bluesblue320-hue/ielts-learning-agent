# Copy this file to .env and supply local-only values as Phase 1 services require.
# Never commit real credentials.
IELTS_ENVIRONMENT=development
IELTS_DATABASE_URL=postgresql+psycopg://ielts_app:replace-with-local-password@localhost:5432/ielts_agent
POSTGRES_USER=ielts_app
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=ielts_agent
POSTGRES_PORT=5432
